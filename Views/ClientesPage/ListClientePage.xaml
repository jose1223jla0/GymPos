<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GymPos.Views.ClientesPage.ListClientePage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.ClientesPage"
    xmlns:tv="using:WinUI.TableView"
    xmlns:model="using:GymPos.ViewModels.ClienteVM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid 
        Margin="20"
        RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toast de Notificaciones Espectacular -->
        <Border x:Name="NotificationToastBorder"
                Grid.Row="0"
                Visibility="Collapsed"
                CornerRadius="12"
                Padding="20,16,20,16"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Margin="0,0,0,10">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icono indicador -->
                <Grid x:Name="IconContainer"
                      Grid.Column="0"
                      Width="40"
                      Height="40"
                      CornerRadius="8"
                      Background="#0078D4">
                    <FontIcon x:Name="NotificationIcon"
                              Glyph="&#xE946;"
                              FontSize="20"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="White"/>
                </Grid>

                <!-- Contenido (Título y Mensaje) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="TitleTextBlock"
                               Text="Notificación"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    <TextBlock x:Name="MessageTextBlock"
                               Text="Mensaje de notificación"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Botón cerrar -->
                <Button Grid.Column="2"
                        Background="Transparent"
                        Padding="8"
                        Click="CloseButton_Click"
                        VerticalAlignment="Top">
                    <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                </Button>
            </Grid>
        </Border>
        

        <StackPanel 
            Grid.Row="1">
            <TextBlock 
                Text="Clientes Registrados"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                FontStyle="Normal"
                FontSize="16"/>
        </StackPanel>


        <tv:TableView
            ItemsSource="{x:Bind ViewModel.ClientesPagina}"
            Grid.Row="2"
            FontSize="13"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single">
            <tv:TableView.Columns>
                <!-- AVATAR -->
                <tv:TableViewTemplateColumn 
                    Header="Avatar" 
                    Width="80">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel 
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <!-- AVATAR -->
                                <Grid 
                                    Width="34" 
                                    Height="34">
                                    <Ellipse Fill="{ThemeResource AccentAAFillColorDefaultBrush}"/>

                                    <TextBlock 
                                        Text="JA"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="14"
                                        FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>

                <tv:TableViewTextColumn
                    Header="DNI"
                    Width="200"
                    Binding="{Binding Dni}" />

                <tv:TableViewTextColumn
                    Width="200"
                    Header="Nombres"
                    Binding="{Binding Nombres}" />

                <tv:TableViewTextColumn
                    Header="Apellidos"
                    Width="200"
                    Binding="{Binding Apellidos}" />

                <tv:TableViewTemplateColumn
                    Header="Acciones"
                    Width="200">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel 
                                Orientation="Horizontal" 
                                Spacing="10">
                                <!-- EDITAR -->
                                <Button 
                                    Background="Transparent"
                                    Command="{Binding ElementName=Root, Path=ViewModel.EditCommand}"
                                    CommandParameter="{Binding}" >
                                    <FontIcon 
                                        Glyph="&#xE70F;" 
                                        Foreground="Red" 
                                        FontSize="15"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns>
        </tv:TableView>

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,10,0"
            Spacing="10">
            <Button 
                Command="{x:Bind ViewModel.PreviousPageCommand}">
                <FontIcon Glyph="&#xE76B;" />
            </Button>
            <TextBlock 
                Text="{x:Bind ViewModel.CurrentPage}" />
            <TextBlock 
                Text="/" />
            <TextBlock 
                Text="{x:Bind ViewModel.TotalPages}" />
            <Button 
                Command="{x:Bind ViewModel.NextPageCommand}">
                <FontIcon Glyph="&#xE76C;" />
            </Button>
        </StackPanel>


        <ContentDialog 
            x:Name="ClienteDialog"
            Title="Editar Cliente"
            MaxWidth="500"
            CornerRadius="16"
            Padding="0"
            PrimaryButtonText="Guardar"
            CloseButtonText="Cancelar"
            PrimaryButtonClick="ClienteDialog_PrimaryButtonClick">
            <local:EditClientePage/>
        </ContentDialog>
    </Grid>
</Page>
