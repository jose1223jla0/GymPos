<Page
    x:Class="GymPos.Views.CajaPage.ResumenCajaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.CajaPage"
    xmlns:models="using:GymPos.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d">

    <!-- Grid raíz -->
    <Grid>

        <!-- Contenido principal -->
        <Grid Padding="24" RowSpacing="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        Text="Caja principal"
                        FontSize="22"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="{x:Bind ViewModel.FechaAperturaStr, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    x:Name="StatusBadge"
                    Width="80"
                    Height="30"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <TextBlock
                        x:Name="StatusText"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <!-- MÉTRICAS -->
            <Grid Grid.Row="1" ColumnSpacing="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Monto inicial -->
                <Border
                    Grid.Column="0"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>
                        <TextBlock
                            Text="Monto inicial"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.MontoInicialStr, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Ingresos -->
                <Border
                    Grid.Column="1"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>
                        <TextBlock
                            Text="Ingresos"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalIngresosStr, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#107C10"/>
                    </StackPanel>
                </Border>

                <!-- Egresos -->
                <Border
                    Grid.Column="2"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>
                        <TextBlock
                            Text="Egresos"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalEgresosStr, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#C50F1F"/>
                    </StackPanel>
                </Border>

                <!-- Saldo -->
                <Border
                    Grid.Column="3"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel>
                        <TextBlock
                            Text="Saldo actual"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.SaldoActualStr, Mode=OneWay}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#0078D4"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- LISTA MOVIMIENTOS -->
            <Border
                Grid.Row="2"
                Padding="12"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <Grid RowDefinitions="Auto,*">

                    <TextBlock
                        Text="Movimientos del día"
                        FontWeight="SemiBold"
                        Margin="0,0,0,12"/>

                    <ListView
                        Grid.Row="1"
                        x:Name="MovimientosListView"
                        ItemsSource="{x:Bind ViewModel.Movimientos, Mode=OneWay}"
                        SelectionMode="Single">

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MovimientoCaja">

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="12"
                                    Padding="0,6">

                                    <Border
                                        Grid.Column="0"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="6"
                                        Background="#65E6B2">

                                        <FontIcon
                                            Glyph="&#xEAC2;"
                                            FontSize="16"
                                            Foreground="#333"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="{x:Bind Concepto}"
                                            FontSize="13"/>

                                        <TextBlock
                                            Text="{x:Bind Fecha}"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind MontoEfectivoStr}"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Foreground="#27A128"
                                        VerticalAlignment="Center"/>
                                </Grid>

                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Grid>
            </Border>

            <!-- ACCIONES -->
            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">

                <Button
                    x:Name="AbrirBtn"
                    Content="Aperturar caja"
                    Click="OnAbrirCajaClick"
                    Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                    IsEnabled="{x:Bind ViewModel.CajaCerrada, Mode=OneWay}"/>

                <Button
                    x:Name="CerrarBtn"
                    Content="Cerrar caja"
                    Click="OnCerrarCajaClick"
                    IsEnabled="{x:Bind ViewModel.CajaAbierta, Mode=OneWay}"
                    Background="{ThemeResource SystemAccentColor}"
                    Foreground="White"/>
            </StackPanel>

        </Grid>

        <!-- INFOBAR FLOTANTE -->
        <muxc:InfoBar
            x:Name="NotificationInfoBar"
            IsOpen="False"
            IsClosable="True"
            Width="320"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,20,0"
            Severity="Informational"
            Title=""
            Message="" />
    </Grid>
</Page>