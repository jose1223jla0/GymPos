<Page
    x:Class="GymPos.Views.CajaPage.ResumenCajaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.CajaPage"
    xmlns:models="using:GymPos.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="24" RowSpacing="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock 
                    Text="Caja principal"
                    FontSize="22"
                    FontWeight="SemiBold"/>
                <TextBlock 
                    Text="{x:Bind ViewModel.FechaAperturaStr, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <!-- Badge de estado -->
            <Border 
                Grid.Column="1"
                x:Name="StatusBadge"
                Width="80"
                Height="30"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TextBlock 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    x:Name="StatusText"
                    FontSize="12"
                    FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <muxc:InfoBar x:Name="NotificationInfoBar"
                      Grid.Row="1"
                      IsOpen="False"
                      Margin="0,12,0,0"
                      IsClosable="True"
                      Title=""
                      Message=""
                      Severity="Informational" />

        <!-- Métricas -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Monto inicial -->
            <Border Grid.Column="0"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Monto inicial"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.MontoInicialStr, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                </StackPanel>
            </Border>

            <!-- Ingresos -->
            <Border Grid.Column="1"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Ingresos"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalIngresosStr, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#107c10"/>
                </StackPanel>
            </Border>

            <!-- Egresos -->
            <Border Grid.Column="2"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Egresos"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.TotalEgresosStr, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#c50f1f"/>
                </StackPanel>
            </Border>

            <!-- Saldo -->
            <Border Grid.Column="3"
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Saldo actual"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.SaldoActualStr, Mode=OneWay}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#0078d4"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lista movimientos -->
        <Border Grid.Row="2"
                Padding="12"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <Grid RowDefinitions="Auto,*">
                <TextBlock Text="Movimientos del día"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <ListView Grid.Row="1"
                          x:Name="MovimientosListView"
                          ItemsSource="{x:Bind ViewModel.Movimientos, Mode=OneWay}"
                          SelectionMode="Single">

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MovimientoCaja">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12"
                                  Padding="0,6">
                                <!-- Icono tipo -->
                                <Border 
                                    Grid.Column="0"
                                    Width="32"
                                    Height="32"
                                    CornerRadius="6"
                                    Background="#65E6B2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <FontIcon 
                                        Glyph="&#xEAC2;"
                                        FontSize="16"
                                        Foreground="#333"/>
                                </Border>
                                <!-- Concepto + Fecha -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Concepto}"
                                               FontSize="13"/>
                                    <TextBlock Text="{x:Bind Fecha}"
                                               FontSize="10"
                                               Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                                </StackPanel>

                                <!-- Monto -->
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="#27A128"
                                           FontWeight="Bold"
                                           Text="{x:Bind MontoEfectivoStr}"
                                           FontSize="13"/>
                            </Grid>

                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- Acciones -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <!--
                IsEnabled = CajaCerrada:
                Solo se puede aperturar si la caja está cerrada.
            -->
            <Button x:Name="AbrirBtn"
                    Content="Aperturar caja"
                    Click="OnAbrirCajaClick"
                    IsEnabled="{x:Bind ViewModel.CajaCerrada, Mode=OneWay}"/>

            <!--
                IsEnabled = CajaAbierta:
                Solo se puede cerrar si la caja está abierta.
            -->
            <Button x:Name="CerrarBtn"
                    Content="Cerrar caja"
                    Click="OnCerrarCajaClick"
                    IsEnabled="{x:Bind ViewModel.CajaAbierta, Mode=OneWay}"
                    Background="{ThemeResource SystemAccentColor}"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
