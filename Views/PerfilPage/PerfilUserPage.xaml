<Page
    x:Class="GymPos.Views.PerfilPage.PerfilUserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.PerfilPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="5">
        <StackPanel 
            Width="600" 
            Margin="50"
            HorizontalAlignment="Center" 
            Spacing="16">

            <!-- Card de perfil -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32">
                <StackPanel Spacing="20">
                    <TextBlock 
                        HorizontalAlignment="Center"
                        FontSize="18"
                        Foreground="#777"
                        Text="Mi Perfil"/>

                    <!-- Avatar -->
                    <Border Width="80" Height="80"
                            CornerRadius="40"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE77B;"
                                  FontSize="36"
                                  Foreground="White"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Border>

                    <!-- Nombre completo -->
                    <TextBlock x:Name="TxtNombreCompleto"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <!-- Rol Badge con icono -->
                    <Border x:Name="RolBadge"
                            CornerRadius="12"
                            Padding="14,5"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D7;"
                                      FontSize="12"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TxtRol"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource FocusVisualBlackStrokeThemeBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Separador elegante -->
                    <Border Height="1"
                            Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                            Margin="0,4"/>

                    <!-- Info grid -->
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- DNI/Usuario -->
                        <Border Grid.Column="0" Grid.Row="0"
                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="11" Opacity="0.5"/>
                                    <TextBlock Text="DNI / Usuario" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtDni"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Estado -->
                        <Border 
                            Grid.Column="1" Grid.Row="0"
                            BorderThickness="1"
                            Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                            CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE73E;" FontSize="11" Opacity="0.5"/>
                                    <TextBlock Text="Estado" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse x:Name="EstadoDot" Width="8" Height="8" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtEstado" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Nombre -->
                        <Border Grid.Column="0" Grid.Row="1"
                                BorderThickness="1"
                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE77B;" FontSize="11" Opacity="0.5"/>
                                    <TextBlock Text="Nombre" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtNombre"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Apellidos -->
                        <Border Grid.Column="1" Grid.Row="1"
                                Background="{ThemeResource LayerOnAccentAcrylicFillColorDefaultBrush}"
                                CornerRadius="8" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE716;" FontSize="11" Opacity="0.5"/>
                                    <TextBlock Text="Apellidos" FontSize="11" Opacity="0.6"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtApellidos"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>
            </Border>

            <!-- Botón Cerrar Sesión — tono destructivo -->
            <Button 
                HorizontalAlignment="Stretch"
                Height="44"
                CornerRadius="8"
                Background="#1AE53935"
                BorderBrush="#E53935"
                BorderThickness="1"
                Foreground="#E53935"
                Click="BtnCerrarSesion_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xF3B1;" FontSize="16" Foreground="#E53935"/>
                    <TextBlock Text="Cerrar Sesión" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>