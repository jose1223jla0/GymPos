<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GymPos.Views.ProductoPage.CreateProductoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.ProductoPage"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="400">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel 
                HorizontalAlignment="Center"
                Padding="5">

                <!-- Encabezado -->
                <StackPanel Spacing="4"
                            Margin="0,0,0,12">

                    <FontIcon Glyph="&#xEC47;"
                              FontSize="32"
                              HorizontalAlignment="Center"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                    <TextBlock Text="Agregar producto"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="Ingrese la información del producto"
                               Opacity="0.7"
                               HorizontalAlignment="Center" />

                </StackPanel>

                <!-- Error -->

                <InfoBar IsOpen="{Binding HasError}"
                         IsClosable="False"
                         Severity="Error"
                         Margin="0,0,0,12"
                         CornerRadius="8"
                         Content="{Binding MensajeError}" />

                <!-- Nombre -->

                <StackPanel Spacing="4"
                            Margin="0,8,0,0">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">

                        <FontIcon Glyph="&#xEC47;"
                                  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                        <TextBlock Text="Nombre *"
                                   FontSize="12"
                                   Opacity="0.7" />

                    </StackPanel>

                    <TextBox x:Name="TxtNombre"
                             Text="{Binding NombreProducto, Mode=TwoWay}"
                             Width="380"
                             PlaceholderText="Ej: Proteína Whey 1kg"
                             CornerRadius="8"
                             TextChanged="TxtNombre_TextChanged" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <TextBlock Text="{Binding NombreMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding NombreValido, Converter={StaticResource InvertedBoolToVisConverter}}" />

                        <TextBlock Text="✓ Correcto"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding NombreValido, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </StackPanel>

                </StackPanel>

                <!-- Categoría -->

                <StackPanel Spacing="4"
                            Margin="0,6,0,0">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">

                        <FontIcon Glyph="&#xE8D2;"
                                  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                        <TextBlock Text="Categoría *"
                                   FontSize="12"
                                   Opacity="0.7" />

                    </StackPanel>

                    <ComboBox x:Name="CmbCategoria"
                              ItemsSource="{Binding Categorias}"
                              SelectedItem="{Binding CategoriaSeleccionada, Mode=TwoWay}"
                              Width="380"
                              DisplayMemberPath="NombreCategoria"
                              PlaceholderText="Seleccione una categoría"
                              CornerRadius="8"
                              SelectionChanged="CmbCategoria_SelectionChanged" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <TextBlock Text="{Binding CategoriaMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding CategoriaValida, Converter={StaticResource InvertedBoolToVisConverter}}" />

                        <TextBlock Text="✓ Correcto"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding CategoriaValida, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </StackPanel>

                </StackPanel>

                <!-- Stock -->

                <StackPanel Spacing="4"
                            Margin="0,6,0,0">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">

                        <FontIcon Glyph="&#xE8B7;"
                                  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                        <TextBlock Text="Stock *"
                                   FontSize="12"
                                   Opacity="0.7" />

                    </StackPanel>

                    <NumberBox x:Name="NbStock"
                               Value="{Binding StockProducto, Mode=TwoWay}"
                               Minimum="0"
                               SmallChange="1"
                               ValueChanged="NbStock_ValueChanged" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <TextBlock Text="{Binding StockMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding StockValido, Converter={StaticResource InvertedBoolToVisConverter}}" />

                        <TextBlock Text="✓ Correcto"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding StockValido, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </StackPanel>

                </StackPanel>

                <!-- Precio -->

                <StackPanel Spacing="4"
                            Margin="0,6,0,0">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">

                        <FontIcon Glyph="&#xEAFD;"
                                  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}" />

                        <TextBlock Text="Precio (S/) *"
                                   FontSize="12"
                                   Opacity="0.7" />

                    </StackPanel>

                    <NumberBox x:Name="NbPrecio"
                               Value="{Binding PrecioProductoDouble, Mode=TwoWay}"
                               Minimum="0"
                               ValueChanged="NbPrecio_ValueChanged" />

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <TextBlock Text="{Binding PrecioMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding PrecioValido, Converter={StaticResource InvertedBoolToVisConverter}}" />

                        <TextBlock Text="✓ Correcto"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding PrecioValido, Converter={StaticResource BoolToVisibilityConverter}}" />

                    </StackPanel>

                </StackPanel>

                <!-- Loading -->

                <ProgressBar x:Name="LoadingBar"
                             Margin="0,16,0,0"
                             Height="4"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>