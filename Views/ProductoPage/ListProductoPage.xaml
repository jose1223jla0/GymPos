<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="Root"
    x:Class="GymPos.Views.ProductoPage.ListProductoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.ProductoPage"
    xmlns:models="using:GymPos.Models"
    xmlns:tv="using:WinUI.TableView"
    xmlns:localVM="using:GymPos.ViewModels.CarritoVM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== -->
        <!-- IZQUIERDA: FORMULARIO -->
        <!-- ===================== -->
        <Border
            Grid.Column="0"
            Margin="10,0,10,0"
            Padding="16"
            CornerRadius="16"
            BorderThickness="1"
            BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}">

            <StackPanel Spacing="20">

                <StackPanel 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    Spacing="8">
                    <FontIcon 
                        Glyph="&#xE710;"
                        FontSize="22"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock 
                        Text="Registrar Producto"
                        FontSize="20"
                        FontWeight="SemiBold"/>
                </StackPanel>

                <TextBox 
                    PlaceholderText="Nombre del producto"
                    Header="Nombre" />

                <!--<TextBox Header="Stock"
                     Text="{x:Bind ViewModel.Producto.StockProducto, Mode=TwoWay}" />-->

                <NumberBox
        Header="Stock"
        PlaceholderText="Cantidad disponible"
        SpinButtonPlacementMode="Inline"
        SmallChange="1" />

                <NumberBox
        Header="Precio"
        PlaceholderText="0.00"
        SpinButtonPlacementMode="Inline"
        SmallChange="0.50" />



                <ComboBox
                    PlaceholderText="Categoria del Producto"
                    Header="Categoria"/>

                <!--<ComboBox Header="Categoría"
                      ItemsSource="{x:Bind ViewModel.Categorias}"
                      SelectedItem="{x:Bind ViewModel.Producto.Categoria, Mode=TwoWay}"
                      DisplayMemberPath="NombreCategoria"/>-->

                <!--<Button Content="Guardar"
                    Command="{x:Bind ViewModel.SaveCommand}"
                    HorizontalAlignment="Stretch"/>-->

                <Button
                    Content="Guardar"
                    Background="{ThemeResource AccentAAFillColorDefaultBrush}"
                    HorizontalAlignment="Stretch"/>

            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- DERECHA: LISTA -->
        <!-- ===================== -->
        <tv:TableView
            Grid.Column="1"
            ItemsSource="{x:Bind ViewModel.ListProductos}"
            FontSize="13"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single">

            <tv:TableView.Columns>

                <tv:TableViewTextColumn Header="Categoría"
                                   Width="180"
                                   Binding="{Binding Categoria.NombreCategoria}" />

                <tv:TableViewTextColumn Header="Nombre"
                                   Width="200"
                                   Binding="{Binding NombreProducto}" />

                <tv:TableViewTextColumn Header="Stock"
                                   Width="80"
                                   Binding="{Binding StockProducto}" />

                <tv:TableViewTextColumn Header="Precio"
                                   Width="100"
                                   Binding="{Binding PrecioProducto, Converter={StaticResource PrecioConverter}}" />

                <tv:TableViewTextColumn Header="Estado"
                                   Width="150"
                                   Binding="{Binding EstadoProducto, Converter={StaticResource EstadoProductoConverter}}" />

                <tv:TableViewTemplateColumn Header="Acciones"
                                       Width="120">

                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8">

                                <Button Command="{Binding ElementName=Root, Path=ViewModel.EditCommand}"
                                    CommandParameter="{Binding}">
                                    <FontIcon Glyph="&#xE70F;" />
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>

                </tv:TableViewTemplateColumn>

            </tv:TableView.Columns>

        </tv:TableView>

    </Grid>
</Page>
