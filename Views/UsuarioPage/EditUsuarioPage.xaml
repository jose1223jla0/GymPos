<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GymPos.Views.UsuarioPage.EditUsuarioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.UsuarioPage"
    xmlns:converters="using:GymPos.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </Grid.Resources>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="420"
                        Padding="16"
                        Spacing="12">

                <!-- Encabezado -->
                <StackPanel Spacing="6"
                            Margin="0,0,0,10">

                    <FontIcon Glyph="&#xE716;"
                              FontSize="32"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              HorizontalAlignment="Center"/>

                    <TextBlock Text="Editar usuario"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Solo rol, estado y contraseña"
                               Opacity="0.7"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error -->
                <InfoBar IsOpen="{Binding HasError, Mode=TwoWay}"
                         IsClosable="False"
                         Severity="Error"
                         CornerRadius="8"
                         Content="{Binding MensajeError}" />

                <!-- Nombre -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="Nombre" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <TextBox x:Name="TxtNombre"
                             Text="{Binding NombreUsuario, Mode=TwoWay}"
                             IsReadOnly="True"
                             CornerRadius="8"/>
                </StackPanel>

                <!-- Apellidos -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE77B;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="Apellidos" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <TextBox x:Name="TxtApellidos"
                             Text="{Binding ApellidosUsuario, Mode=TwoWay}"
                             IsReadOnly="True"
                             CornerRadius="8"/>
                </StackPanel>

                <!-- DNI / Usuario -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE13D;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="DNI / Usuario" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <TextBox x:Name="TxtDni"
                             Text="{Binding UsernameDni, Mode=TwoWay}"
                             IsReadOnly="True"
                             CornerRadius="8"/>
                </StackPanel>

                <MenuFlyoutSeparator/>

                <!-- Rol -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE902;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="Rol" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbRol"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding RolSeleccionado, Mode=TwoWay}"
                              HorizontalAlignment="Stretch"
                              CornerRadius="8"/>
                </StackPanel>

                <!-- Estado -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE115;" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="Estado" FontSize="12" Opacity="0.7"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="TglEstado"
                                  IsOn="{Binding EstadoUsuario, Mode=TwoWay}"
                                  OnContent="Activo"
                                  OffContent="Inactivo"/>
                </StackPanel>

                <MenuFlyoutSeparator/>

                <!-- Contraseña -->
                <StackPanel Spacing="4">
                    <CheckBox x:Name="ChkCambiarPassword"
                              Content="Cambiar contraseña"
                              IsChecked="{Binding CambiarPassword, Mode=TwoWay}"/>

                    <PasswordBox x:Name="TxtPassword"
                                 PlaceholderText="Nueva contraseña"
                                 CornerRadius="8"
                                 PasswordChanged="TxtPassword_PasswordChanged"
                                 Visibility="{Binding CambiarPassword, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <TextBlock x:Name="TxtCoincide"
                               Text="✓ Las contraseñas coinciden"
                               FontSize="12"
                               Foreground="Green"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtNoCoincide"
                               Text="✗ Las contraseñas no coinciden"
                               FontSize="12"
                               Foreground="Red"
                               Visibility="Collapsed"/>

                    <PasswordBox x:Name="TxtConfirmar"
                                 PlaceholderText="Confirmar contraseña"
                                 CornerRadius="8"
                                 PasswordChanged="TxtConfirmar_PasswordChanged"
                                 Visibility="{Binding CambiarPassword, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Loading -->
                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Height="4"
                             Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
