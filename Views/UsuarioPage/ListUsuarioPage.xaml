<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GymPos.Views.UsuarioPage.ListUsuarioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.UsuarioPage"
    xmlns:models="using:GymPos.Models"
    xmlns:converters="using:GymPos.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootContainer">

        <!-- ========================= -->
        <!-- CONTENIDO PRINCIPAL -->
        <!-- ========================= -->
        <Grid Margin="20"
              RowSpacing="12"
              x:Name="Root">

            <Grid.Resources>
                <converters:RolToBrushConverter x:Key="RolBrush"/>
                <converters:BoolToBrushConverter x:Key="EstadoBrush"/>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Usuarios"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.AddCommand}"
                        Visibility="{x:Bind AddButtonVisibility}"
                        Padding="16,8"
                        CornerRadius="8"
                        Background="{ThemeResource AccentAAFillColorDefaultBrush}">

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">

                        <FontIcon Glyph="&#xE710;"
                                  Foreground="White"/>

                        <TextBlock Text="Agregar Usuario"
                                   Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- LISTA -->
            <ListView Grid.Row="1"
                      Margin="0,2,0,0"
                      ItemsSource="{x:Bind ViewModel.ListUsuario}"
                      SelectionMode="Single">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Usuario">

                        <Border Margin="0,6"
                                Padding="3"
                                CornerRadius="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- DATOS -->
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"
                                            VerticalAlignment="Center">

                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="24"
                                            Background="{ThemeResource AccentAAFillColorDefaultBrush}">

                                        <TextBlock Text="{Binding Initiales}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel>

                                        <TextBlock Text="{Binding NombreUsuario}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{Binding UsernameDni}"
                                                   FontSize="12"
                                                   Opacity="0.65"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ROL -->
                                <Border Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        Background="{Binding Rol, Converter={StaticResource RolBrush}}">

                                    <TextBlock Text="{Binding RolTexto}"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- ESTADO -->
                                <Border Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="10"
                                        Padding="10,4"
                                        Background="{Binding EstadoUsuario, Converter={StaticResource EstadoBrush}}">

                                    <TextBlock Text="{Binding EstadoTexto}"
                                               Foreground="White"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- EDITAR -->
                                <StackPanel Grid.Column="3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <Button Background="Transparent"
                                            BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10,6"
                                            Click="EditButton_Click"
                                            Tag="{Binding}">

                                        <FontIcon Glyph="&#xE70F;"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>

        <!-- ========================= -->
        <!-- TOAST FLOTANTE -->
        <!-- ========================= -->
        <Border x:Name="NotificationToastBorder"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,20,20,0"
                Width="380"
                Padding="20,16"
                CornerRadius="12"
                BorderThickness="1"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Canvas.ZIndex="999">

            <Border.Shadow>
                <ThemeShadow/>
            </Border.Shadow>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ICONO -->
                <Border x:Name="IconContainer"
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="8"
                        Background="#0078D4">

                    <FontIcon x:Name="NotificationIcon"
                              Glyph="&#xE946;"
                              FontSize="20"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <!-- TEXTO -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">

                    <TextBlock x:Name="TitleTextBlock"
                               Text="Notificación"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="MessageTextBlock"
                               Text="Mensaje de notificación"
                               FontSize="13"
                               Opacity="0.8"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- CERRAR -->
                <Button Grid.Column="2"
                        Background="Transparent"
                        Padding="8"
                        Click="CloseButton_Click">

                    <FontIcon Glyph="&#xE71B;"
                              FontSize="14"/>
                </Button>

            </Grid>

        </Border>

        <!-- ========================= -->
        <!-- DIALOGS -->
        <!-- ========================= -->

        <ContentDialog x:Name="CreateUsuarioDialog"
                       MinWidth="750"
                       MaxWidth="900"
                       DefaultButton="Primary"
                       PrimaryButtonText="Guardar"
                       CloseButtonText="Cancelar"
                       PrimaryButtonClick="CreateUsuarioDialog_PrimaryButtonClick">

            <local:CreateUsuarioPage x:Name="CreateUserEditor"/>
        </ContentDialog>

        <ContentDialog x:Name="EditUsuarioDialog"
                       
                       MinWidth="750"
                       MaxWidth="900"
                       DefaultButton="Primary"
                       PrimaryButtonText="Guardar"
                       CloseButtonText="Cancelar"
                       PrimaryButtonClick="EditUsuarioDialog_PrimaryButtonClick">

            <local:EditUsuarioPage x:Name="EditUserEditor"/>
        </ContentDialog>

    </Grid>

</Page>