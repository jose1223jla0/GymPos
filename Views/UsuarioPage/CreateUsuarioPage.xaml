<UserControl
    x:Class="GymPos.Views.UsuarioPage.CreateUsuarioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.UsuarioPage"
    xmlns:converters="using:GymPos.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.Resources>
            <converters:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </Grid.Resources>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Width="420"
                        Padding="16">

                <!-- Encabezado -->
                <StackPanel Spacing="6"
                            Margin="0,0,0,10">

                    <FontIcon Glyph="&#xE716;"
                              FontSize="32"
                              Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                              HorizontalAlignment="Center"/>

                    <TextBlock Text="Crear nuevo usuario"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Ingrese la información del nuevo usuario"
                               Opacity="0.7"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error -->
                <InfoBar x:Name="ErrorBar"
                         IsOpen="{Binding HasError, Mode=TwoWay}"
                         IsClosable="False"
                         Severity="Error"
                         CornerRadius="8"
                         Content="{Binding MensajeError}" />

                <!-- Nombre -->
                <StackPanel Spacing="4">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon Glyph="&#xE77B;"
                                  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="Nombre *"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <TextBox x:Name="TxtNombre"
                             Text="{Binding NombreUsuario, Mode=TwoWay}"
                             TextChanged="TxtNombre_TextChanged"
                             PlaceholderText="Nombre del usuario"
                             CornerRadius="8"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding NombreMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding NombreValido, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                        <TextBlock Text="OK"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding NombreValido, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Apellidos -->
                <StackPanel Spacing="4">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon Glyph="&#xE77B;"
                                   Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                        <TextBlock Text="Apellidos *"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <TextBox x:Name="TxtApellidos"
                             Text="{Binding ApellidosUsuario, Mode=TwoWay}"
                             TextChanged="TxtApellidos_TextChanged"
                             PlaceholderText="Apellidos del usuario"
                             CornerRadius="8"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding ApellidosMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding ApellidosValido, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                        <TextBlock Text="OK"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding ApellidosValido, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Usuario / DNI -->
                <StackPanel Spacing="4">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                   Glyph="&#xE13D;"/>
                        <TextBlock Text="DNI / Usuario *"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <TextBox x:Name="TxtDni"
                             Text="{Binding UsernameDni, Mode=TwoWay}"
                             BeforeTextChanging="TxtDni_BeforeTextChanging"
                             PlaceholderText="Ej: 12345678"
                             CornerRadius="8"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding UsernameDniMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding UsernameDniValido, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                        <TextBlock Text="OK"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding UsernameDniValido, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Rol -->
                <StackPanel Spacing="4">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                   Glyph="&#xE902;"/>
                        <TextBlock Text="Rol *"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <ComboBox x:Name="CmbRol"
                              ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding RolSeleccionado, Mode=TwoWay}"
                              PlaceholderText="Seleccione un rol"
                              HorizontalAlignment="Stretch"
                              CornerRadius="8"/>
                </StackPanel>

                <MenuFlyoutSeparator/>

                <!-- Contraseña -->
                <StackPanel x:Name="PanelPassword"
                            Spacing="4">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                   Glyph="&#xE72E;"/>
                        <TextBlock Text="Contraseña *"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <PasswordBox x:Name="TxtPassword"
                                 PlaceholderText="Mínimo 6 caracteres"
                                 CornerRadius="8"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding PasswordMensaje}"
                                   FontSize="12"
                                   Foreground="Red"
                                   Visibility="{Binding PasswordValido, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                        <TextBlock Text="OK"
                                   FontSize="12"
                                   Foreground="Green"
                                   Visibility="{Binding PasswordValido, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Confirmar -->
                <StackPanel x:Name="PanelConfirmar"
                            Spacing="4">

                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <FontIcon  Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
                                   Glyph="&#xE8FB;"/>
                        <TextBlock Text="Confirmar Contraseña *"
                                   FontSize="12"
                                   Opacity="0.7"/>
                    </StackPanel>

                    <PasswordBox x:Name="TxtConfirmar"
                                 PlaceholderText="Repite la contraseña"
                                 CornerRadius="8"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <TextBlock x:Name="TxtCoincide"
                               Text="✓ Las contraseñas coinciden"
                               FontSize="12"
                               Foreground="Green"
                               Visibility="Collapsed"/>

                    <TextBlock x:Name="TxtNoCoincide"
                               Text="✗ Las contraseñas no coinciden"
                               FontSize="12"
                               Foreground="Red"
                               Visibility="Collapsed"/>

                </StackPanel>

                <!-- Loading -->
                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Height="4"
                             Margin="0,8,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>