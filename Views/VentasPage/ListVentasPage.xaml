<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="RootPage"
    x:Class="GymPos.Views.VentasPage.ListVentasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.VentasPage"
    xmlns:converters="using:GymPos.Converters"
    xmlns:vm="using:GymPos.ViewModels.ProductoVM"
    xmlns:vmCat="using:GymPos.ViewModels.CategoriaVM"
    xmlns:models="using:GymPos.Models"
    xmlns:ViewModels="using:GymPos.ViewModels.ProductoVM"
    xmlns:vm1="using:GymPos.ViewModels.CarritoVM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter    x:Key="BoolToVis"/>
        <converters:InvertedBoolToVisConverter   x:Key="InverseBoolToVis"/>
        <converters:ZeroToVisibilityConverter    x:Key="ZeroToVis"/>
        <converters:NullOrEmptyToBoolConverter   x:Key="NotNullToBoolConverter"/>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <TextBox
            Grid.Row="0"
            PlaceholderText="Buscar productos......."
            x:Name="SearchTextBox"
            Text="{x:Bind ViewModel.TerminoBusqueda, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="SearchTextBox_TextChanged"
            Margin="0,6,0,6"/>
        <!-- Layout principal -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ══════ PANEL PRODUCTOS ══════ -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- Filtro categorías -->
                <ScrollViewer Grid.Row="0"
                              HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Categorias, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vmCat:CategoriaViewModel">
                                <ToggleButton
                                    Content="{x:Bind NombreCategoria}"
                                    IsChecked="{x:Bind IsSeleccionada, Mode=OneWay}"
                                    CornerRadius="16"
                                    Padding="14,6"
                                    FontSize="13"
                                    Command="{Binding DataContext.ViewModel.SeleccionarCategoriaCommand,  ElementName=RootPage}"
                                    CommandParameter="{x:Bind}"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Spinner -->
                <ProgressRing Grid.Row="1"
                              IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Width="48" Height="48"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                <!-- Grid de productos -->
                <ScrollViewer Grid.Row="2"
                              Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Productos, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="160" 
                                MinItemHeight="130"
                                ItemsStretch="Fill"
                                MinColumnSpacing="10" MinRowSpacing="10"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductoViewModel">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Padding="0"
                                    CornerRadius="10"
                                    IsEnabled="{x:Bind TieneStock, Mode=OneWay}"
                                    Command="{Binding DataContext.ViewModel.AgregarAlCarritoCommand, ElementName=RootPage}"
                                    CommandParameter="{x:Bind}">

                                    <StackPanel Padding="14,12" Spacing="5">
                                        <FontIcon 
                                            Glyph="&#xE7BF;" 
                                            FontSize="28"
                                            HorizontalAlignment="Left"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock
                                            Text="{x:Bind NombreProducto}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            TextWrapping="Wrap" MaxLines="2"/>
                                        <TextBlock
                                            Text="{x:Bind PrecioFormateado}"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Stock: "/>
                                                <Run Text="{x:Bind StockProducto, Mode=OneWay}"/>
                                            </TextBlock>

                                            <Border 
                                                Background="#C92079"
                                                CornerRadius="6" Padding="4,2"
                                                Visibility="{x:Bind StockProducto, Mode=OneWay,Converter={StaticResource ZeroToVis}}">
                                                <TextBlock 
                                                    Text="Sin stock"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="#fff"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
            </Grid>

            <!-- ══════ PANEL CARRITO ══════ -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2" CornerRadius="12" Padding="16">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" 
                                    VerticalAlignment="Center"
                                    Spacing="15"
                                    Orientation="Horizontal">
                            <FontIcon Glyph="&#xE7BF;" FontSize="29" Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"/>
                            <TextBlock Text="Carrito"
                                       FontSize="16"
                                       Style="{StaticResource SubtitleTextBlockStyle}"/>
                        </StackPanel>

                        <!-- Badge cantidad total -->
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="8" 
                                HorizontalAlignment="Right"
                                Grid.Column="1"
                                Width="50"
                                Height="20" 
                                Visibility="{x:Bind ViewModel.HayItems, Mode=OneWay,
                                                 Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                        FontSize="10"
                                       TextAlignment="Center"
                                        Foreground="White">
                                    <Run Text="{x:Bind ViewModel.TotalItems, Mode=OneWay}"/>
                                    <Run Text=" items"/>
                            </TextBlock>
                        </Border>

                    </Grid>



                    <!-- Lista / estado vacío -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,12">
                        <Grid MinHeight="200">

                            <!-- Vacío -->
                            <StackPanel
                                Visibility="{x:Bind ViewModel.HayItems, Mode=OneWay,
                                             Converter={StaticResource InverseBoolToVis}}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8" Padding="0,40">
                                <FontIcon Glyph="&#xE7BF;" FontSize="32"
                                          HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Text="Agrega productos al carrito"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Items -->
                            <ItemsRepeater
                                ItemsSource="{x:Bind ViewModel.Carrito, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HayItems, Mode=OneWay,
                                             Converter={StaticResource BoolToVis}}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="8"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm1:CarritoItemViewModel">
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="8" Padding="10,8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="0" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock
                                                        Text="{x:Bind NombreProducto}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                                        <Run Text="S/ " FontWeight="Bold"/>
                                                        <Run Text="{x:Bind SubtotalFormateado, Mode=OneWay}" FontWeight="Bold"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Cantidad -->
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <Button Content="−"
                                                            Width="26" Height="26"
                                                            Padding="0" CornerRadius="13"
                                                            FontSize="15"
                                                            Command="{Binding DataContext.ViewModel.QuitarDelCarritoCommand,
                                                                      ElementName=RootPage}"
                                                            CommandParameter="{x:Bind}"/>
                                                    <TextBlock
                                                        Text="{x:Bind Cantidad, Mode=OneWay}"
                                                        VerticalAlignment="Center"
                                                        MinWidth="20" TextAlignment="Center"
                                                        Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <Button Content="+"
                                                            Width="26" Height="26"
                                                            Padding="0" CornerRadius="13"
                                                            FontSize="15"
                                                            Command="{Binding DataContext.ViewModel.AgregarAlCarritoCommand,
                                                                      ElementName=RootPage}"
                                                            CommandParameter="{x:Bind}"/>
                                                </StackPanel>

                                                <!-- Eliminar -->
                                                <Button 
                                                    Grid.Column="2"
                                                    Width="26" Height="26"
                                                    Padding="0" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ViewModel.EliminarItemCommand, ElementName=RootPage}"
                                                    CommandParameter="{x:Bind}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="11"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </Grid>
                    </ScrollViewer>

                    <!-- Separador -->
                    <Border 
                        Grid.Row="2" Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,0,0,12"/>

                    <!-- Total -->
                    <Grid Grid.Row="3" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock 
                            Text="Total"
                            VerticalAlignment="Center"/>
                        <TextBlock 
                            Grid.Column="1"
                            FontWeight="Bold"
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                            <Run Text="S/ "/>
                            <Run Text="{x:Bind ViewModel.TotalFormateado, Mode=OneWay}"/>
                        </TextBlock>
                    </Grid>

                    <!-- Error -->
                    <InfoBar 
                        Grid.Row="4"
                        IsOpen="{x:Bind ViewModel.MensajeError, Mode=OneWay, Converter={StaticResource NotNullToBoolConverter}}"
                        Message="{x:Bind ViewModel.MensajeError, Mode=OneWay}"
                        Severity="Error"
                        IsClosable="True"
                        Margin="0,0,0,8"/>

                    <!-- Botones -->
                    <StackPanel Grid.Row="5" Spacing="8">
                        <Button HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnRegistrarVentaClick"
                                IsEnabled="{x:Bind ViewModel.HayItems, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9F5;" FontSize="16"/>
                                <TextBlock Text="Registrar venta"/>
                            </StackPanel>
                        </Button>
                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.LimpiarCarritoCommand}"
                                IsEnabled="{x:Bind ViewModel.HayItems, Mode=OneWay}">
                            <TextBlock Text="Limpiar carrito"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== INFOBAR FLOTANTE ===================== -->
        <InfoBar
            x:Name="InfoBarNotificacion"
            Width="320"
            IsOpen="False"
            IsClosable="True"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,20,0"
            Severity="Success"/>
    </Grid>
</Page>
