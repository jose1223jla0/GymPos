<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="GymPos.Views.AsistenciaPage.ListAsistenciaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GymPos.Views.AsistenciaPage"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:GymPos.ViewModels.Asistencias"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Buscar por DNI, nombres o apellidos"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Padding="12"
            CornerRadius="12"
            BorderBrush="{ThemeResource AccentAAFillColorSecondaryBrush}"
            BorderThickness="1">

            <controls:DataGrid
                ItemsSource="{Binding SuscripcionesActivas}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                FontSize="13"
                RowHeight="48"
                GridLinesVisibility="Horizontal"
                RowBackground="{ThemeResource AccentAAFillColorDisabled}">

                <controls:DataGrid.Columns>

                    <!--======= DNI =======-->
                    <controls:DataGridTextColumn
                        Header="DNI"
                        FontSize="13"
                        Binding="{Binding Suscripcion.Cliente.Dni}"
                        Width="110" />

                    <!--======= NOMBRES =======-->
                    <controls:DataGridTextColumn
                        Header="Nombres"
                        FontSize="13"
                        Binding="{Binding Suscripcion.Cliente.Nombres}"
                        Width="140" />

                    <!--======= APELLIDOS =======-->
                    <controls:DataGridTextColumn
                        Header="Apellidos"
                        FontSize="13"
                        Binding="{Binding Suscripcion.Cliente.Apellidos}"
                        Width="160" />

                    <!--======= FECHA INICIO =======-->
                    <controls:DataGridTextColumn
                        Header="Fecha Inicio"
                        FontSize="13"
                        Binding="{Binding Suscripcion.FechaInicio}"
                        Width="120" />

                    <!--======= ASISTENCIA =======-->
                    <controls:DataGridTextColumn
                        Header="Asistencia"
                        FontSize="13"
                        Binding="{Binding TotalSesiones}"
                        Width="100" />

                    <!--======= SESIONES =======-->
                    <controls:DataGridTextColumn
                        Header="Sesiones"
                        FontSize="13"
                        Binding="{Binding Suscripcion.Membresia.Sesiones}"
                        Width="100" />

                    <!--======= FECHA FIN =======-->
                    <controls:DataGridTextColumn
                        Header="Fecha Fin"
                        FontSize="13"
                        Binding="{Binding Suscripcion.FechaFin}"
                        Width="120" />

                    <!--======= ACCIÓN =======-->
                    <controls:DataGridTemplateColumn
                        Header="Acción"
                        Width="150">

                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Click="Button_Click"
                                    IsEnabled="{Binding AsistioHoy, Converter={StaticResource InvertedBooleanConverter}}"
                                    Background="{ThemeResource AccentAAFillColorTertiaryBrush}">

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Center">

                                        <FontIcon
                                            Glyph="&#xE74E;"
                                            Foreground="{ThemeResource FocusVisualWhiteStrokeThemeBrush}" />

                                        <TextBlock
                                            Text="{Binding AsistioHoy, Converter={StaticResource AsistenciaTextConverter}}"
                                            Foreground="{ThemeResource FocusVisualWhiteStrokeThemeBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Border>

        <muxc:InfoBar
            x:Name="NotificationInfoBar"
            Margin="0,12,0,0"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            IsOpen="False"
            IsClosable="True"
            Title=""
            Message=""
            Severity="Informational" />

    </Grid>

</Page>